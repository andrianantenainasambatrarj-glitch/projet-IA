# =============================================================================
#  TradeVision IA — exemple de configuration
#  Copiez ce fichier en `.env` :  cp .env.example .env
#  Toutes les variables sont OPTIONNELLES : sans aucune clé, l'application
#  fonctionne en « mode démo » (moteur technique + recherche dans vos cours).
# =============================================================================

# ---------------------------------------------------------------- Application
DEBUG=false
LOG_LEVEL=INFO
# Protection facultative de l'API : si défini, /api/* exige l'en-tête X-API-Token
API_ACCESS_TOKEN=
# Origines autorisées pour le navigateur (séparées par des virgules ; * = toutes)
CORS_ORIGINS=*
MAX_UPLOAD_MB=12

# ------------------------------------------------------------ LLM (vision/texte)
# auto = détecte automatiquement le premier fournisseur configuré
# Valeurs : auto | demo | gemini | openai | anthropic | openrouter | ollama
LLM_PROVIDER=auto
# Modèles (laisser vide = valeur par défaut du fournisseur)
VISION_MODEL=
TEXT_MODEL=
LLM_TEMPERATURE=0.25
LLM_MAX_TOKENS=2600
LLM_TIMEOUT_S=120

# Clé GRATUITE recommandée : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternatives
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modèle local (Ollama) — vision : qwen2.5vl, llama3.2-vision, llava…
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ------------------------------------------------------------------ Embeddings
# auto | hashing (local, instantané) | gemini | openai | local (sentence-transformers)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_DIM=512
ENABLE_LOCAL_EMBEDDINGS=true

# -------------------------------------------------------------------- Recherche
CHUNK_SIZE_WORDS=420
CHUNK_OVERLAP_WORDS=90
TOP_K=5
# 1.0 = 100 % vecteurs ; 0.0 = 100 % mots-clés (BM25)
HYBRID_ALPHA=0.55
MAX_CONTEXT_CHARS=14000

# --------------------------------------------------------- Base vectorielle
# auto (SQLite) | sqlite | chroma
VECTOR_BACKEND=auto

# ------------------------------------------------------------ Données de marché
# auto (yfinance → Yahoo → Stooq → démo) | yfinance | yahoo | stooq | demo
MARKET_PROVIDER=auto
MARKET_TIMEOUT_S=20
DEFAULT_PERIOD=6mo
DEFAULT_INTERVAL=1d
DEMO_CANDLES=260

# -------------------------------------------------------------------- Stockage
# Répertoire de travail (index, documents importés, historique)
DATA_DIR=./data
AUTO_INGEST_ON_START=true
