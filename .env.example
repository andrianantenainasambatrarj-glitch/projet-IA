# =============================================================================
#  TradeVision IA — exemple de configuration
#  Copiez ce fichier en `.env` :  cp .env.example .env
#  Toutes les variables sont OPTIONNELLES : sans aucune clé, l'application
#  fonctionne en « mode démo » (moteur technique + recherche dans vos cours).
# =============================================================================

# ---------------------------------------------------------------- Application
DEBUG=false
LOG_LEVEL=INFO
# Protection facultative de l'API : si défini, /api/* exige l'en-tête X-API-Token
API_ACCESS_TOKEN=
# Origines autorisées pour le navigateur (séparées par des virgules ; * = toutes)
CORS_ORIGINS=*
MAX_UPLOAD_MB=12

# ------------------------------------------------------------ LLM (vision/texte)
# auto = détecte automatiquement le premier fournisseur configuré
# Valeurs : auto | demo | gemini | openai | anthropic | openrouter | ollama
LLM_PROVIDER=auto
# Modèles — LAISSER VIDE pour Gemini : l'application découvre automatiquement les
# modèles disponibles pour votre clé et bascule si Google en retire un
# (ex. gemini-2.5-flash retiré → gemini-3.6-flash). À ne remplir que pour l'imposer.
VISION_MODEL=
TEXT_MODEL=
LLM_TEMPERATURE=0.25
LLM_MAX_TOKENS=2600
LLM_TIMEOUT_S=120

# Clé GRATUITE recommandée : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternatives
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modèle local (Ollama) — vision : qwen2.5vl, llama3.2-vision, llava…
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ------------------------------------------------------------------ Embeddings
# auto | hashing (local, instantané) | gemini | openai | local (sentence-transformers)
EMBEDDING_PROVIDER=auto
# Modèle d'embedding : laisser vide = détection automatique (gemini-embedding-001…)
EMBEDDING_MODEL=
EMBEDDING_DIM=512
ENABLE_LOCAL_EMBEDDINGS=true

# -------------------------------------------------------------------- Recherche
CHUNK_SIZE_WORDS=420
CHUNK_OVERLAP_WORDS=90
TOP_K=5
# 1.0 = 100 % vecteurs ; 0.0 = 100 % mots-clés (BM25)
HYBRID_ALPHA=0.55
MAX_CONTEXT_CHARS=14000

# --------------------------------------------------------- Base vectorielle
# auto (SQLite) | sqlite | chroma
VECTOR_BACKEND=auto

# ------------------------------------------------------------ Données de marché
# auto = crypto via Binance, puis yfinance → Yahoo → Stooq → démo
# Valeurs : auto | yfinance | yahoo | stooq | binance | demo
MARKET_PROVIDER=auto
MARKET_TIMEOUT_S=20
DEFAULT_PERIOD=6mo
DEFAULT_INTERVAL=1d
DEMO_CANDLES=260

# ------------------------------------------------- Notifications & veille
# Envoi automatique des analyses (Telegram recommandé : gratuit et simple).
# 1) @BotFather → /newbot → copiez le jeton
# 2) Envoyez /start à votre bot, puis lisez votre chat id sur
#    https://api.telegram.org/bot<JETON>/getUpdates  (result[0].message.chat.id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alternative : webhook générique (Discord, Slack, ntfy, Zapier, n8n…)
#   Discord : Paramètres du salon → Intégrations → Webhooks → copier l'URL
#   ntfy    : https://ntfy.sh/mon-sujet
NOTIFY_WEBHOOK_URL=

# Veille automatique : analyse la watchlist à intervalle régulier et n'envoie
# que les marchés dont |score| >= NOTIFY_MIN_SCORE.
NOTIFY_ENABLED=false
NOTIFY_INTERVAL_MINUTES=240
NOTIFY_MIN_SCORE=0
NOTIFY_TIMEOUT_S=25
WATCHLIST=AAPL,BTC-USD,^FCHI,EURUSD=X
WATCHLIST_PERIOD=6mo
WATCHLIST_INTERVAL=1d

# URL publique de l'application, ajoutée en bas des messages envoyés
APP_BASE_URL=

# -------------------------------------------------------------------- Stockage
# Répertoire de travail (index, documents importés, historique)
DATA_DIR=./data
AUTO_INGEST_ON_START=true
